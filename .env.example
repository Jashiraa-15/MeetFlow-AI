# JWT Configuration
JWT_SECRET=replace-this-with-a-secure-random-secret-key-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
DATABASE_URL=sqlite:///./meeting_clarifier.db

# OpenAI API Configuration (for Stage 3+)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WHISPER_USE_LOCAL=false

# SMTP Settings (for Stage 7+)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@meetingclarifier.local

# n8n Workflow Webhook Settings (Optional)
N8N_WEBHOOK_SECRET=n8n-webhook-secret-meeting-clarifier-2026
N8N_CLARIFICATION_WEBHOOK_URL=http://localhost:5678/webhook/meeting-clarification

